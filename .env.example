# ============================================================
# SYSTEMHOME - Variables de Entorno
# Copie este archivo a .env y complete los valores
# ============================================================

# Puerto del servidor
PORT=3000

# Secreto para firmar los tokens JWT (cámbielo en producción)
JWT_SECRET=change-this-secret-to-a-secure-value

# Ruta de la base de datos local (SQLite)
DB_PATH=./backend/database/systemhome.sqlite

# ============================================================
# BASE DE DATOS EN LA NUBE (opcional)
# Descomente y configure para usar PostgreSQL en la nube.
# Ejemplo: postgres://usuario:password@host:5432/systemhome
# Requiere: npm install pg
# ============================================================
# DATABASE_URL=postgres://usuario:password@host-puerto:5432/systemhome

# ============================================================
# CORREO (opcional - para notificaciones por email)
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-contraseña-de-app
# SMTP_FROM=SYSTEMHOME <tu-correo@gmail.com>

# URL del frontend (para enlaces en correos)
FRONTEND_URL=http://localhost:3000