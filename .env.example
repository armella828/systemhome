# ============================================================
# SYSTEMHOME - Variables de Entorno para Producción & Local
# ============================================================

# Entorno ('development' o 'production')
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Secreto para firmar los tokens JWT (obligatorio cambiar en producción)
JWT_SECRET=generar-clave-segura-y-larga-para-produccion

# ============================================================
# 1. BASE DE DATOS LOCAL (SQLite - desarrollo local por defecto)
# ============================================================
DB_PATH=./backend/database/systemhome.sqlite

# ============================================================
# 2. BASE DE DATOS EN LA NUBE (Neon Console / PostgreSQL)
# Copie la cadena de conexión de su proyecto en https://console.neon.tech
# Ejemplo: postgresql://usuario:password@ep-xyz.us-east-2.aws.neon.tech/systemhome?sslmode=require
# ============================================================
# DATABASE_URL=postgresql://usuario:password@ep-xyz.us-east-2.aws.neon.tech/systemhome?sslmode=require

# ============================================================
# 3. ALMACENAMIENTO MULTIMEDIA (Cloudinary)
# Obtenga estas credenciales desde su panel en https://cloudinary.com
# ============================================================
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret

# ============================================================
# 4. FRONTEND / CORS (Vercel)
# URL de su aplicación web desplegada en Vercel
# ============================================================
FRONTEND_URL=https://tu-proyecto.vercel.app

# ============================================================
# 5. CORREO SMTP REAL (recuperacion de contrasena y bienvenida)
# Funciona con Gmail, Outlook, Resend SMTP, Brevo, etc.
# NUNCA subir valores reales a GitHub.
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-cuenta@dominio.com
# SMTP_PASS=tu-contrasena-de-aplicacion
# MAIL_FROM=no-responder@dominio.com
# MAIL_FROM_NAME=SYSTEMHOME
# APP_URL=https://systemhome-aa7v.onrender.com
# RESET_TOKEN_TTL_MINUTES=30