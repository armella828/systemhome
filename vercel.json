{
  "version": 2,
  "name": "systemhome",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://systemhome-backend.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://systemhome-backend.onrender.com/uploads/$1"
    },
    {
      "source": "/health",
      "destination": "https://systemhome-backend.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/systemhome/$1"
    }
  ]
}
